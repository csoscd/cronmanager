{
    "name": "cs/cronmanager",
    "description": "Cronmanager – PHP Web UI and Host Agent for managing cron jobs",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Christian Schulz",
            "email": "technik@meinetechnikwelt.rocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hassankhan/config": "^2.1",
        "monolog/monolog": "^3.6",
        "guzzlehttp/guzzle": "^7.8",
        "phpmailer/phpmailer": "^6.8",
        "dragonmantank/cron-expression": "^3.3",
        "lorisleiva/cron-translator": "^0.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.21"
    },
    "autoload": {
        "psr-4": {
            "Cronmanager\\Agent\\": "agent/src/",
            "Cronmanager\\Web\\": "web/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
